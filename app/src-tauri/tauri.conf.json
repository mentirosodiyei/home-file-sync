{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home File Sync",
  "mainBinaryName": "home-file-sync",
  "version": "0.3.0",
  "identifier": "org.homefilesync.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Home File Sync",
        "width": 540,
        "height": 760,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Sincroniza carpetas entre equipos de la misma red, sin configurar nada.",
    "copyright": "Home File Sync contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
