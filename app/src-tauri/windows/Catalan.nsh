LangString addOrReinstall ${LANG_CATALAN} "Afegeix o reinstal·la components"
LangString alreadyInstalled ${LANG_CATALAN} "Ja instal·lat"
LangString alreadyInstalledLong ${LANG_CATALAN} "${PRODUCTNAME} ${VERSION} ja està instal·lat. Tria l'operació que vols fer i fes clic a Següent per continuar."
LangString appRunning ${LANG_CATALAN} "{{product_name}} s'està executant! Tanca'l primer i torna-ho a provar."
LangString appRunningOkKill ${LANG_CATALAN} "{{product_name}} s'està executant!$\nFes clic a D'acord per tancar-lo"
LangString chooseMaintenanceOption ${LANG_CATALAN} "Tria l'opció de manteniment que vols fer."
LangString chooseHowToInstall ${LANG_CATALAN} "Tria com vols instal·lar ${PRODUCTNAME}."
LangString createDesktop ${LANG_CATALAN} "Crea una drecera a l'escriptori"
LangString dontUninstall ${LANG_CATALAN} "No el desinstal·lis"
LangString dontUninstallDowngrade ${LANG_CATALAN} "No el desinstal·lis (aquest instal·lador no permet tornar a una versió anterior sense desinstal·lar)"
LangString failedToKillApp ${LANG_CATALAN} "No s'ha pogut tancar {{product_name}}. Tanca'l primer i torna-ho a provar"
LangString installingWebview2 ${LANG_CATALAN} "S'està instal·lant WebView2..."
LangString newerVersionInstalled ${LANG_CATALAN} "Ja hi ha instal·lada una versió més nova de ${PRODUCTNAME}! No es recomana instal·lar una versió anterior. Si realment vols instal·lar aquesta versió anterior, és millor desinstal·lar primer la versió actual. Tria l'operació que vols fer i fes clic a Següent per continuar."
LangString older ${LANG_CATALAN} "anterior"
LangString olderOrUnknownVersionInstalled ${LANG_CATALAN} "Hi ha instal·lada una versió $R4 de ${PRODUCTNAME}. Es recomana desinstal·lar la versió actual abans d'instal·lar. Tria l'operació que vols fer i fes clic a Següent per continuar."
LangString silentDowngrades ${LANG_CATALAN} "Aquest instal·lador no permet tornar a una versió anterior; no es pot continuar amb la instal·lació silenciosa. Fes servir l'instal·lador gràfic.$\n"
LangString unableToUninstall ${LANG_CATALAN} "No s'ha pogut desinstal·lar!"
LangString uninstallApp ${LANG_CATALAN} "Desinstal·la ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_CATALAN} "Desinstal·la abans d'instal·lar"
LangString unknown ${LANG_CATALAN} "desconeguda"
LangString webview2AbortError ${LANG_CATALAN} "No s'ha pogut instal·lar WebView2! L'aplicació no pot funcionar sense. Prova de reiniciar l'instal·lador."
LangString webview2DownloadError ${LANG_CATALAN} "Error: no s'ha pogut baixar WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_CATALAN} "L'instal·lador de WebView2 s'ha baixat correctament"
LangString webview2Downloading ${LANG_CATALAN} "S'està baixant l'instal·lador de WebView2..."
LangString webview2InstallError ${LANG_CATALAN} "Error: la instal·lació de WebView2 ha fallat amb el codi $1"
LangString webview2InstallSuccess ${LANG_CATALAN} "WebView2 s'ha instal·lat correctament"
LangString deleteAppData ${LANG_CATALAN} "Elimina les dades de l'aplicació"
